---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import DevPainPoints from '../components/DevPainPoints.astro';
import SpeedAndSafety from '../components/SpeedAndSafety.astro';
import LiveInteractiveDashboard from '../components/LiveInteractiveDashboard.astro';
import TerminalInstall from '../components/TerminalInstall.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <div class="reveal-on-scroll">
      <DevPainPoints />
    </div>
    <div class="reveal-on-scroll">
      <SpeedAndSafety />
    </div>
    <div class="reveal-on-scroll">
      <LiveInteractiveDashboard />
    </div>
    <div class="reveal-on-scroll">
      <TerminalInstall />
    </div>
    <div class="reveal-on-scroll">
      <FaqSection />
    </div>
  </main>
  <Footer />
</Layout>
