---
import {
  Trash2,
  Gauge,
  PlugZap,
  MemoryStick,
  MoonStar,
  FolderSearch,
  PackageMinus,
  PanelTop,
} from 'lucide-astro';

const tools = [
  { icon: Trash2, title: "Cache cleanup", desc: "Reclaim 20–50 GB from AI and build caches." },
  { icon: Gauge, title: "AI spend tracking", desc: "Daily budget alerts before costs surprise you." },
  { icon: PlugZap, title: "Port release", desc: "Free :3000 or :5173 without killing terminals." },
  { icon: MemoryStick, title: "Memory shield", desc: "Quit RAM hogs, protect your editor and shell." },
  { icon: MoonStar, title: "Keep awake", desc: "Block sleep during long builds automatically." },
  { icon: FolderSearch, title: "Large files", desc: "Find multi-GB build outputs in seconds." },
  { icon: PackageMinus, title: "App uninstaller", desc: "Remove apps plus their ~/Library leftovers." },
  { icon: PanelTop, title: "Menu bar panel", desc: "Status at a glance, zero cost when closed." },
];
---

<section id="tools" class="relative py-24 sm:py-32">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="eyebrow flex items-center gap-2">
        <span class="eyebrow-dot"></span> Eight tools, one app
      </p>
      <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight text-white sm:text-5xl font-display">
        Stop juggling utilities.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-400">
        Everything you reach for during local development, in a single native binary.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {tools.map((t) => {
        const Icon = t.icon;
        return (
          <div class="card card-hover spotlight group p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-zinc-300 transition-colors group-hover:border-emerald-400/40 group-hover:text-emerald-300">
              <Icon class="h-4 w-4" />
            </div>
            <h3 class="mt-4 text-[15px] font-semibold text-white font-display">{t.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{t.desc}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
