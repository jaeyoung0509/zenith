---
import AppleIcon from './icons/AppleIcon.astro';
import ConvergenceVisual from './ConvergenceVisual.astro';
import { PlugZap, Gauge, MoonStar } from 'lucide-astro';
---

<section id="top" class="relative overflow-hidden pb-16 pt-36 sm:pt-44">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Clean, tasteful starlight pill badge -->
      <div class="rise rise-1 mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] py-1.5 pl-3 pr-4 text-xs text-zinc-300 backdrop-blur-md">
        <span class="pulse-dot"></span>
        Free &amp; open source for macOS and Windows
      </div>

      <!-- Headline with elegant starlight gradient -->
      <h1 class="rise rise-2 cosmic-title text-balance text-4xl font-semibold leading-[1.08] tracking-tight sm:text-6xl md:text-7xl">
        One light app for<br />local development.
      </h1>

      <!-- Subtitle -->
      <p class="rise rise-3 mx-auto mt-6 max-w-xl text-pretty text-base leading-relaxed text-zinc-400 sm:text-lg">
        Clear caches, free stuck ports, track AI spend, and keep builds awake.
        Fast, safe, and light on resources.
      </p>

      <!-- Action buttons -->
      <div class="rise rise-4 mt-8 flex flex-col items-center justify-center gap-3.5 sm:flex-row">
        <a href="#install" class="btn-primary w-full sm:w-auto">
          <AppleIcon class="h-4 w-4" />
          <span>Download for free</span>
        </a>
        <a href="#playground" class="btn-ghost w-full sm:w-auto">
          Try the live demo
        </a>
      </div>

      <!-- Key metric cards -->
      <dl class="rise rise-5 mx-auto mt-12 grid max-w-xl grid-cols-3 gap-3 text-left">
        <div class="card p-4">
          <dt class="font-mono text-[10px] uppercase tracking-widest text-zinc-500">Launch</dt>
          <dd class="mt-1 font-mono text-lg font-semibold text-white sm:text-xl">&lt;0.08s</dd>
          <div class="mt-1 font-mono text-[10px] text-zinc-500">Native Rust</div>
        </div>
        <div class="card p-4">
          <dt class="font-mono text-[10px] uppercase tracking-widest text-zinc-500">Memory</dt>
          <dd class="mt-1 font-mono text-lg font-semibold text-white sm:text-xl">~80 MB</dd>
          <div class="mt-1 font-mono text-[10px] text-zinc-500">Zero idle drain</div>
        </div>
        <div class="card p-4">
          <dt class="font-mono text-[10px] uppercase tracking-widest text-zinc-500">Data sent</dt>
          <dd class="mt-1 font-mono text-lg font-semibold text-emerald-400 sm:text-xl">0 bytes</dd>
          <div class="mt-1 font-mono text-[10px] text-emerald-400/80">100% Local</div>
        </div>
      </dl>
    </div>

    <!-- Floating Zenith App Preview Window -->
    <div class="rise rise-5 relative mx-auto mt-16 max-w-2xl">
      <div class="float-soft card overflow-hidden !rounded-2xl shadow-[0_30px_100px_-20px_rgba(0,0,0,0.95)] border border-white/[0.1] backdrop-blur-2xl">
        <div class="flex items-center justify-between border-b border-white/[0.07] bg-white/[0.02] px-5 py-3">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          </div>
          <span class="font-mono text-[11px] text-zinc-400">Zenith</span>
          <span class="flex items-center gap-1.5 font-mono text-[11px] text-emerald-400">
            <span class="pulse-dot !h-1.5 !w-1.5"></span> Local
          </span>
        </div>

        <div class="space-y-4 px-6 py-5">
          <div>
            <div class="flex items-baseline justify-between">
              <span class="text-sm text-zinc-400">Reclaimable</span>
              <span class="font-mono text-3xl font-semibold text-white">23.8 GB</span>
            </div>
            <div class="relative mt-3 h-2 overflow-hidden rounded-full bg-zinc-800">
              <div class="bar-fill-anim bar-shimmer relative h-full rounded-full bg-gradient-to-r from-emerald-400 to-teal-300"></div>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 font-mono text-[11px]">
            <div class="rounded-xl border border-white/[0.07] bg-black/40 px-3 py-2.5">
              <div class="flex items-center gap-1.5 text-zinc-500"><PlugZap class="h-3 w-3" />PORTS</div>
              <div class="mt-0.5 text-white">:3000 freed</div>
            </div>
            <div class="rounded-xl border border-white/[0.07] bg-black/40 px-3 py-2.5">
              <div class="flex items-center gap-1.5 text-zinc-500"><Gauge class="h-3 w-3" />AI SPEND</div>
              <div class="mt-0.5 text-white">$3.42 today</div>
            </div>
            <div class="rounded-xl border border-white/[0.07] bg-black/40 px-3 py-2.5">
              <div class="flex items-center gap-1.5 text-zinc-500"><MoonStar class="h-3 w-3" />BUILD</div>
              <div class="mt-0.5 text-emerald-400">Awake</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Many apps -> one: Convergence Visual -->
    <div class="rise rise-5">
      <ConvergenceVisual />
    </div>
  </div>
</section>
