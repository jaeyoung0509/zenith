---
import GithubIcon from './icons/GithubIcon.astro';
---

<footer class="border-t border-white/[0.06] py-12">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6">
    <div class="flex items-center gap-2.5">
      <img src="/app-icon.svg" alt="Zenith" class="h-6 w-6" />
      <span class="text-sm font-semibold text-white">Zenith</span>
      <span class="text-xs text-zinc-600">Free &amp; open source</span>
    </div>

    <nav class="flex items-center gap-6 text-[13px] text-zinc-500">
      <a href="#tools" class="transition-colors hover:text-white">Tools</a>
      <a href="#performance" class="transition-colors hover:text-white">Performance</a>
      <a href="#install" class="transition-colors hover:text-white">Install</a>
      <a
        href="https://github.com/jaeyoung0509/zenith"
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-1.5 transition-colors hover:text-white"
      >
        <GithubIcon class="h-3.5 w-3.5" />
        GitHub
      </a>
    </nav>

    <p class="text-xs text-zinc-600">© {new Date().getFullYear()} Zenith</p>
  </div>
</footer>
