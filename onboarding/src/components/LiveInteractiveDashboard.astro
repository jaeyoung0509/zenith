---
const ports = [
  { port: ":5173", name: "Vite dev server", pid: "PID 48921" },
  { port: ":3000", name: "Next.js app", pid: "PID 50114" },
  { port: ":9222", name: "Chrome debug", pid: "PID 51203" },
];
---

<section id="playground" class="relative py-24 sm:py-32">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow flex items-center justify-center gap-2">
        <span class="eyebrow-dot"></span> Live demo
      </p>
      <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight text-white sm:text-5xl font-display">
        Try it right here.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-zinc-400">
        A small taste of the real app, running in your browser.
      </p>
    </div>

    <div class="card mx-auto mt-12 max-w-2xl overflow-hidden">
      <div class="flex gap-1 border-b border-white/[0.07] p-2 bg-white/[0.01]">
        {["Clean", "Ports", "Awake"].map((t, i) => (
          <button
            data-demo-tab={t.toLowerCase()}
            class={`demo-tab flex-1 rounded-xl px-4 py-2.5 text-sm transition-colors ${
              i === 0 ? "bg-white/[0.08] text-white" : "text-zinc-500 hover:text-zinc-200"
            }`}
          >
            {t}
          </button>
        ))}
      </div>

      <div class="p-6 sm:p-8">
        <!-- CLEAN -->
        <div id="demo-clean" class="demo-panel">
          <div class="flex items-baseline justify-between">
            <span class="text-sm text-zinc-400">Reclaimable</span>
            <span id="demo-gb" class="font-mono text-4xl font-semibold text-white">23.8 GB</span>
          </div>
          <div class="mt-4 h-2 overflow-hidden rounded-full bg-zinc-800">
            <div id="demo-bar" class="h-full rounded-full bg-emerald-400 transition-all duration-300" style="width: 78%"></div>
          </div>
          <div class="mt-6 flex gap-3">
            <button id="demo-purge" class="btn-primary flex-1 !py-2.5">Clean now</button>
            <button id="demo-rescan" class="btn-ghost !py-2.5">Rescan</button>
          </div>
        </div>

        <!-- PORTS -->
        <div id="demo-ports" class="demo-panel hidden">
          <div class="flex items-center justify-between">
            <span class="text-sm text-zinc-400">Stuck ports</span>
            <span id="demo-port-count" class="font-mono text-sm text-zinc-300">3 active</span>
          </div>
          <div id="demo-port-list" class="mt-4 space-y-2">
            {ports.map((p) => (
              <div class="demo-port-row flex items-center justify-between rounded-xl border border-white/[0.07] bg-black/40 px-4 py-3 transition-all duration-300">
                <div class="flex items-center gap-3">
                  <span class="rounded-lg bg-white/[0.06] px-2.5 py-1 font-mono text-xs font-semibold text-white">{p.port}</span>
                  <div>
                    <div class="text-sm text-zinc-200">{p.name}</div>
                    <div class="font-mono text-[11px] text-zinc-500">{p.pid}</div>
                  </div>
                </div>
                <button class="demo-release rounded-full border border-white/15 px-3.5 py-1.5 text-xs text-zinc-300 transition-colors hover:border-white/50 hover:text-white">
                  Release
                </button>
              </div>
            ))}
          </div>
        </div>

        <!-- AWAKE -->
        <div id="demo-awake" class="demo-panel hidden">
          <div class="flex items-center justify-between rounded-xl border border-white/[0.07] bg-black/40 px-4 py-4">
            <div>
              <div class="flex items-center gap-2 text-sm font-medium text-white">
                Keep awake
                <span id="demo-awake-pill" class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5 font-mono text-[10px] text-emerald-300">ON</span>
              </div>
              <p class="mt-1 text-xs text-zinc-500">Blocks sleep during long builds.</p>
            </div>
            <button id="demo-awake-toggle" role="switch" aria-checked="true" aria-label="Toggle keep awake" class="relative h-7 w-12 shrink-0 rounded-full bg-emerald-400 transition-colors">
              <span id="demo-awake-knob" class="absolute left-1 top-1 h-5 w-5 rounded-full bg-black transition-all" style="transform: translateX(20px)"></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import confetti from 'canvas-confetti';

  // Tabs
  const demoTabs = document.querySelectorAll('.demo-tab');
  const demoPanels: Record<string, HTMLElement | null> = {
    clean: document.getElementById('demo-clean'),
    ports: document.getElementById('demo-ports'),
    awake: document.getElementById('demo-awake'),
  };

  demoTabs.forEach((t) => {
    t.addEventListener('click', () => {
      const target = (t as HTMLElement).dataset.demoTab || 'clean';
      demoTabs.forEach((b) => {
        b.classList.remove('bg-white/[0.08]', 'text-white');
        b.classList.add('text-zinc-500');
      });
      t.classList.add('bg-white/[0.08]', 'text-white');
      t.classList.remove('text-zinc-500');
      Object.entries(demoPanels).forEach(([k, p]) => p?.classList.toggle('hidden', k !== target));
    });
  });

  // Clean demo
  const gb = document.getElementById('demo-gb');
  const bar = document.getElementById('demo-bar');
  const purge = document.getElementById('demo-purge');
  const rescan = document.getElementById('demo-rescan');
  let value = 23.8;
  let timer: ReturnType<typeof setInterval> | null = null;

  function render() {
    if (gb) gb.textContent = `${value.toFixed(1)} GB`;
    if (bar) bar.style.width = `${(value / 23.8) * 78}%`;
    if (purge) purge.textContent = value === 0 ? 'Cleaned ✓' : value === 23.8 ? 'Clean now' : 'Cleaning…';
  }

  purge?.addEventListener('click', () => {
    if (timer || value === 0) return;
    timer = setInterval(() => {
      value = Math.max(0, value - 2.4);
      render();
      if (value === 0 && timer) {
        clearInterval(timer);
        timer = null;
        confetti({
          particleCount: 25,
          spread: 60,
          origin: { y: 0.7 },
          colors: ['#34d399', '#ffffff'],
          ticks: 80,
          gravity: 0.8,
          scalar: 0.6,
          disableForReducedMotion: true
        });
      }
    }, 80);
  });

  rescan?.addEventListener('click', () => {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
    value = 23.8;
    render();
  });

  // Ports demo
  const portList = document.getElementById('demo-port-list');
  const portCount = document.getElementById('demo-port-count');
  let remaining = 3;

  portList?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.demo-release');
    if (!btn) return;
    const row = btn.closest('.demo-port-row') as HTMLElement;
    if (!row) return;
    row.style.opacity = '0';
    row.style.transform = 'scale(0.97)';
    setTimeout(() => {
      row.remove();
      remaining--;
      if (portCount) portCount.textContent = remaining === 0 ? 'all clear' : `${remaining} active`;
      if (remaining === 0 && portList) {
        portList.innerHTML = '<div class="rounded-xl border border-dashed border-white/15 px-4 py-8 text-center text-sm text-zinc-400">All ports clear. Nothing blocking your dev server.</div>';
      }
    }, 250);
  });

  // Awake demo
  const awakeToggle = document.getElementById('demo-awake-toggle');
  const awakeKnob = document.getElementById('demo-awake-knob');
  const awakePill = document.getElementById('demo-awake-pill');
  let awake = true;

  awakeToggle?.addEventListener('click', () => {
    awake = !awake;
    awakeToggle.setAttribute('aria-checked', String(awake));
    awakeToggle.classList.toggle('bg-emerald-400', awake);
    awakeToggle.classList.toggle('bg-zinc-700', !awake);
    if (awakeKnob) awakeKnob.style.transform = awake ? 'translateX(20px)' : 'translateX(0)';
    if (awakePill) {
      awakePill.textContent = awake ? 'ON' : 'OFF';
      awakePill.className = awake
        ? 'rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5 font-mono text-[10px] text-emerald-300'
        : 'rounded-full border border-white/10 bg-white/[0.04] px-2 py-0.5 font-mono text-[10px] text-zinc-500';
    }
  });
</script>
