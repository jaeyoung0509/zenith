---
import AppleIcon from './icons/AppleIcon.astro';
---

<section id="install" class="relative py-24 sm:py-32">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="card relative overflow-hidden p-8 sm:p-12">
      <div class="relative grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="eyebrow flex items-center gap-2">
            <span class="eyebrow-dot"></span> Get started
          </p>
          <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl font-display">
            Ready in under a minute.
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400">
            If macOS flags the beta build, run one command to clear it.
          </p>
          <div class="mt-4 flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-black/60 px-4 py-3 font-mono text-xs text-zinc-300">
            <span class="truncate"><span class="text-zinc-600">$ </span>xattr -cr /Applications/Zenith.app</span>
            <button id="copy-gatekeeper" class="shrink-0 rounded-full border border-white/15 px-3 py-1 text-[11px] text-zinc-300 transition-colors hover:border-white/50 hover:text-white">
              Copy
            </button>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <a
            href="https://github.com/jaeyoung0509/zenith/releases"
            target="_blank"
            rel="noreferrer"
            class="btn-primary w-full"
          >
            <AppleIcon class="h-4 w-4" />
            Download for Mac
          </a>
          <a
            href="https://github.com/jaeyoung0509/zenith/releases"
            target="_blank"
            rel="noreferrer"
            class="btn-ghost w-full"
          >
            Download for Windows
          </a>
          <div class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-black/60 px-4 py-3 font-mono text-xs text-zinc-300">
            <span class="truncate"><span class="text-zinc-600">$ </span>brew install --cask zenith</span>
            <button class="copy-btn shrink-0 rounded-full border border-white/15 px-3 py-1 text-[11px] text-zinc-300 transition-colors hover:border-white/50 hover:text-white" data-cmd="brew install --cask zenith">
              Copy
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  async function copyText(cmd: string, btn: HTMLElement) {
    try {
      await navigator.clipboard.writeText(cmd);
      const original = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(() => {
        btn.textContent = original;
      }, 1500);
    } catch (e) {
      console.error(e);
    }
  }

  document.getElementById('copy-gatekeeper')?.addEventListener('click', (e) => {
    copyText('xattr -cr /Applications/Zenith.app', e.currentTarget as HTMLElement);
  });

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      copyText((btn as HTMLElement).dataset.cmd || '', btn as HTMLElement);
    });
  });
</script>
