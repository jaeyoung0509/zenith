---
const faqs = [
  {
    q: "Is it really free?",
    a: "Yes. Every feature is free, forever. No subscriptions, no paywalls, no ads. The source is public on GitHub under the MIT license.",
  },
  {
    q: "Can it delete my source code?",
    a: "No. Only verified caches can be removed. Repositories, configs, and credentials are blocked by design.",
  },
  {
    q: "Why is it so light?",
    a: "It's a native Rust binary, not an Electron app. Around 80 MB of memory, launches in under 0.08 seconds.",
  },
  {
    q: "Does my data leave my machine?",
    a: "Never. Everything runs locally. There is no telemetry and nothing is uploaded.",
  },
];
---

<section class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <p class="eyebrow flex items-center justify-center gap-2">
        <span class="eyebrow-dot"></span> FAQ
      </p>
      <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl font-display">
        Questions, answered.
      </h2>
    </div>

    <div class="mt-10 space-y-3">
      {faqs.map((f) => (
        <details class="card group px-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[15px] font-medium text-zinc-100 [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="text-xl font-light text-zinc-500 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="pb-5 text-sm leading-relaxed text-zinc-400">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
