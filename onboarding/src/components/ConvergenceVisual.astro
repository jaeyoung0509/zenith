---
import {
  Trash2,
  Gauge,
  PlugZap,
  MemoryStick,
  MoonStar,
  FolderSearch,
  PackageMinus,
  PanelTop,
  RotateCcw,
  Check,
} from 'lucide-astro';

const apps = [
  { id: 1, side: 'left', icon: Trash2, name: "Disk cleaner", desc: "Cache & junk", ty: "-40px" },
  { id: 2, side: 'left', icon: Gauge, name: "AI cost tracker", desc: "Token budgets", ty: "-15px" },
  { id: 3, side: 'left', icon: PlugZap, name: "Port killer", desc: "Free :3000/:5173", ty: "15px" },
  { id: 4, side: 'left', icon: MemoryStick, name: "RAM monitor", desc: "Memory shield", ty: "40px" },
  { id: 5, side: 'right', icon: MoonStar, name: "Sleep blocker", desc: "Keep awake", ty: "-40px" },
  { id: 6, side: 'right', icon: FolderSearch, name: "Disk analyzer", desc: "Large files", ty: "-15px" },
  { id: 7, side: 'right', icon: PackageMinus, name: "Uninstaller", desc: "Clean apps", ty: "15px" },
  { id: 8, side: 'right', icon: PanelTop, name: "Menu widget", desc: "Quick panel", ty: "40px" },
];
---

<div id="convergence" class="mx-auto mt-28 max-w-5xl">
  <div class="text-center">
    <p class="font-mono text-[11px] uppercase tracking-[0.25em] text-zinc-500">
      Consolidation
    </p>
    <h3 class="mt-2 text-2xl font-semibold tracking-tight text-white sm:text-3xl font-display">
      Put 8 separate apps directly into Zenith.
    </h3>
    <p class="mt-2 text-sm text-zinc-400">
      Instead of running 8 background helpers, Zenith packs everything into one light binary.
    </p>

    <!-- Interactive Mode Switcher -->
    <div class="mt-6 inline-flex items-center rounded-full border border-white/10 bg-white/[0.03] p-1 backdrop-blur-md">
      <button
        id="btn-mode-separated"
        class="mode-btn rounded-full px-4 py-1.5 font-mono text-xs text-zinc-400 transition-all hover:text-white"
      >
        8 Separate apps
      </button>
      <button
        id="btn-mode-unified"
        class="mode-btn rounded-full bg-white px-4 py-1.5 font-mono text-xs font-semibold text-black shadow-md transition-all"
      >
        Packed into Zenith (1 app)
      </button>
    </div>
  </div>

  <!-- Unification Arena -->
  <div class="relative mt-12 flex flex-col items-center justify-center md:flex-row md:items-center">
    
    <!-- Left Outside Apps (1 - 4) -->
    <div class="z-20 flex flex-col gap-3 w-full max-w-[220px] md:w-52">
      {apps.filter(a => a.side === 'left').map((app) => {
        const Icon = app.icon;
        return (
          <div
            class="ext-app ext-app-left"
            id={`ext-app-${app.id}`}
            data-app-id={app.id}
            style={`--ty: ${app.ty};`}
          >
            <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-zinc-900/90 p-3 shadow-lg backdrop-blur-md transition-all hover:border-white/20">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/[0.05] text-zinc-300">
                <Icon class="h-4 w-4" />
              </div>
              <div class="truncate text-left">
                <div class="truncate text-xs font-medium text-white">{app.name}</div>
                <div class="text-[10px] text-zinc-500">{app.desc}</div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Center: The Zenith App Window -->
    <div class="z-30 my-8 w-full max-w-md md:my-0 md:mx-6">
      <div 
        id="zenith-master-card" 
        class="card relative overflow-hidden !rounded-2xl border border-white/15 bg-zinc-950/95 p-6 shadow-[0_20px_80px_-15px_rgba(0,0,0,0.95)] backdrop-blur-2xl transition-transform duration-300"
      >
        <!-- macOS Window Title Bar -->
        <div class="flex items-center justify-between border-b border-white/[0.08] pb-3 text-xs">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          </div>
          <span class="font-mono text-[11px] text-zinc-400">Zenith.app</span>
          <span id="unification-status-pill" class="flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-0.5 font-mono text-[10px] text-emerald-300 transition-all">
            <Check class="h-3 w-3" />
            <span id="unification-pill-text">8 in 1 Unified</span>
          </span>
        </div>

        <!-- Center App Header -->
        <div class="mt-5 text-center">
          <div class="relative mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white/[0.05] p-2 ring-1 ring-white/15 shadow-inner">
            <img id="zenith-core-icon" src="/app-icon.svg" alt="Zenith" class="h-12 w-12 transition-transform duration-300 drop-shadow-[0_0_15px_rgba(16,185,129,0.3)]" />
            <div id="ingest-pulse" class="absolute inset-0 rounded-2xl bg-emerald-400/25 opacity-0 transition-opacity duration-300"></div>
          </div>
          <div class="mt-2.5 text-base font-semibold text-white font-display">Zenith Local Suite</div>
          <p id="unification-counter-text" class="mt-0.5 font-mono text-xs text-zinc-300 transition-colors">
            8 utilities packed into 1 native binary
          </p>
        </div>

        <!-- Inside Zenith: The 8 Unified Module Slots -->
        <div class="mt-6 rounded-xl border border-white/[0.08] bg-black/40 p-3.5">
          <div class="text-[10px] uppercase font-mono tracking-wider text-zinc-500 mb-2.5 flex items-center justify-between">
            <span>Built-in Modules</span>
            <span id="unification-progress-badge" class="text-emerald-400 font-medium">8/8 active</span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-left">
            {apps.map((app) => {
              const Icon = app.icon;
              return (
                <div
                  class="internal-slot flex items-center gap-2 rounded-lg border border-white/[0.06] bg-white/[0.02] px-2.5 py-2 transition-all duration-400 is-active"
                  id={`slot-${app.id}`}
                  data-slot-id={app.id}
                >
                  <div class="slot-icon flex h-6 w-6 shrink-0 items-center justify-center rounded bg-white/[0.05] text-zinc-400 transition-colors">
                    <Icon class="h-3.5 w-3.5" />
                  </div>
                  <span class="slot-name truncate text-[11px] font-medium text-zinc-300 transition-colors">{app.name}</span>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Footnote inside Zenith -->
        <div class="mt-4 flex items-center justify-between font-mono text-[10px] text-zinc-500">
          <span>Native Rust · Zero Electron</span>
          <span class="text-emerald-400">~80 MB total</span>
        </div>
      </div>
    </div>

    <!-- Right Outside Apps (5 - 8) -->
    <div class="z-20 flex flex-col gap-3 w-full max-w-[220px] md:w-52">
      {apps.filter(a => a.side === 'right').map((app) => {
        const Icon = app.icon;
        return (
          <div
            class="ext-app ext-app-right"
            id={`ext-app-${app.id}`}
            data-app-id={app.id}
            style={`--ty: ${app.ty};`}
          >
            <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-zinc-900/90 p-3 shadow-lg backdrop-blur-md transition-all hover:border-white/20">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/[0.05] text-zinc-300">
                <Icon class="h-4 w-4" />
              </div>
              <div class="truncate text-left">
                <div class="truncate text-xs font-medium text-white">{app.name}</div>
                <div class="text-[10px] text-zinc-500">{app.desc}</div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Replay Button -->
  <div class="mt-8 text-center">
    <button
      id="conv-replay"
      class="group inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.02] px-4 py-2 font-mono text-xs text-zinc-400 transition-all hover:border-white/30 hover:text-white"
    >
      <RotateCcw class="h-3.5 w-3.5 transition-transform duration-500 group-hover:-rotate-180" />
      <span>Replay putting apps into Zenith</span>
    </button>
  </div>
</div>

<style>
  /* Individual external app transitions */
  .ext-app {
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1),
                opacity 0.65s ease,
                filter 0.65s ease;
    will-change: transform, opacity;
  }

  /* Default visible state */
  .ext-app:not(.is-ingested) {
    transform: translate(0, 0) scale(1);
    opacity: 1;
    filter: none;
    pointer-events: auto;
  }

  /* Ingested state: Sucked into the center Zenith window */
  @media (min-width: 768px) {
    .ext-app-left.is-ingested {
      transform: translate(calc(100% + 2.5rem), var(--ty, 0px)) scale(0.2);
      opacity: 0;
      filter: blur(4px);
      pointer-events: none;
    }

    .ext-app-right.is-ingested {
      transform: translate(calc(-100% - 2.5rem), var(--ty, 0px)) scale(0.2);
      opacity: 0;
      filter: blur(4px);
      pointer-events: none;
    }
  }

  @media (max-width: 767px) {
    .ext-app-left.is-ingested {
      transform: translate(0, 100px) scale(0.2);
      opacity: 0;
      filter: blur(4px);
      pointer-events: none;
    }

    .ext-app-right.is-ingested {
      transform: translate(0, -100px) scale(0.2);
      opacity: 0;
      filter: blur(4px);
      pointer-events: none;
    }
  }

  /* Internal slots: Inactive vs Active */
  .internal-slot {
    opacity: 0.3;
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .internal-slot.is-active {
    opacity: 1;
    border-style: solid;
    border-color: rgba(16, 185, 129, 0.25);
    background: rgba(16, 185, 129, 0.06);
    transform: scale(1);
    animation: slot-pop 0.35s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .internal-slot.is-active .slot-icon {
    color: #34d399;
    background: rgba(16, 185, 129, 0.15);
  }

  .internal-slot.is-active .slot-name {
    color: #ffffff;
  }

  @keyframes slot-pop {
    0% { transform: scale(0.92); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
</style>

<script>
  import confetti from 'canvas-confetti';

  const container = document.getElementById('convergence');
  const btnSeparated = document.getElementById('btn-mode-separated');
  const btnUnified = document.getElementById('btn-mode-unified');
  const replayBtn = document.getElementById('conv-replay');
  const statusPill = document.getElementById('unification-status-pill');
  const pillText = document.getElementById('unification-pill-text');
  const counterText = document.getElementById('unification-counter-text');
  const progressBadge = document.getElementById('unification-progress-badge');
  const masterCard = document.getElementById('zenith-master-card');
  const coreIcon = document.getElementById('zenith-core-icon');
  const ingestPulse = document.getElementById('ingest-pulse');

  const appIds = [1, 2, 3, 4, 5, 6, 7, 8];
  let activeTimers: ReturnType<typeof setTimeout>[] = [];
  let isAnimating = false;
  let autoPlayed = false;

  function clearAllTimers() {
    activeTimers.forEach(t => clearTimeout(t));
    activeTimers = [];
  }

  // Set all items to fully separated (outside)
  function setSeparatedImmediate() {
    clearAllTimers();
    isAnimating = false;

    appIds.forEach(id => {
      const ext = document.getElementById(`ext-app-${id}`);
      const slot = document.getElementById(`slot-${id}`);
      ext?.classList.remove('is-ingested');
      slot?.classList.remove('is-active');
    });

    // Update UI
    btnSeparated?.classList.add('bg-white', 'text-black', 'font-semibold', 'shadow-md');
    btnSeparated?.classList.remove('text-zinc-400');
    btnUnified?.classList.remove('bg-white', 'text-black', 'font-semibold', 'shadow-md');
    btnUnified?.classList.add('text-zinc-400');

    if (statusPill) {
      statusPill.className = 'flex items-center gap-1.5 rounded-full border border-zinc-700 bg-zinc-800/60 px-2.5 py-0.5 font-mono text-[10px] text-zinc-400';
    }
    if (pillText) pillText.textContent = '8 Separate Apps';
    if (counterText) {
      counterText.textContent = 'Running 8 apps separately (~500 MB RAM)';
      counterText.classList.add('text-zinc-500');
      counterText.classList.remove('text-zinc-300');
    }
    if (progressBadge) {
      progressBadge.textContent = '0/8 packed';
      progressBadge.className = 'text-zinc-500 font-medium';
    }
  }

  // Set all items to fully unified immediately (no animation)
  function setUnifiedImmediate() {
    clearAllTimers();
    isAnimating = false;

    appIds.forEach(id => {
      const ext = document.getElementById(`ext-app-${id}`);
      const slot = document.getElementById(`slot-${id}`);
      ext?.classList.add('is-ingested');
      slot?.classList.add('is-active');
    });

    // Update UI
    btnUnified?.classList.add('bg-white', 'text-black', 'font-semibold', 'shadow-md');
    btnUnified?.classList.remove('text-zinc-400');
    btnSeparated?.classList.remove('bg-white', 'text-black', 'font-semibold', 'shadow-md');
    btnSeparated?.classList.add('text-zinc-400');

    if (statusPill) {
      statusPill.className = 'flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-0.5 font-mono text-[10px] text-emerald-300';
    }
    if (pillText) pillText.textContent = '8 in 1 Unified';
    if (counterText) {
      counterText.textContent = '8 utilities packed into 1 native binary';
      counterText.classList.remove('text-zinc-500');
      counterText.classList.add('text-zinc-300');
    }
    if (progressBadge) {
      progressBadge.textContent = '8/8 active';
      progressBadge.className = 'text-emerald-400 font-medium';
    }
  }

  // Play random one-by-one absorption animation slowly and deliberately!
  function playOneByOneAbsorption() {
    clearAllTimers();
    isAnimating = true;

    // Reset all to outside first
    appIds.forEach(id => {
      const ext = document.getElementById(`ext-app-${id}`);
      const slot = document.getElementById(`slot-${id}`);
      ext?.classList.remove('is-ingested');
      slot?.classList.remove('is-active');
    });

    // Update UI to in-progress state
    btnUnified?.classList.add('bg-white', 'text-black', 'font-semibold', 'shadow-md');
    btnUnified?.classList.remove('text-zinc-400');
    btnSeparated?.classList.remove('bg-white', 'text-black', 'font-semibold', 'shadow-md');
    btnSeparated?.classList.add('text-zinc-400');

    if (statusPill) {
      statusPill.className = 'flex items-center gap-1.5 rounded-full border border-sky-400/30 bg-sky-400/10 px-2.5 py-0.5 font-mono text-[10px] text-sky-300';
    }
    if (pillText) pillText.textContent = 'Packing apps…';
    if (counterText) {
      counterText.textContent = 'Putting separate apps into Zenith…';
      counterText.classList.remove('text-zinc-500');
      counterText.classList.add('text-zinc-300');
    }

    // Shuffle the 8 IDs in completely random order!
    const randomized = [...appIds].sort(() => Math.random() - 0.5);

    // Each app enters one-by-one slowly (every 360ms)
    const intervalMs = 360;

    randomized.forEach((id, index) => {
      // Step A: Launch external card towards center
      const launchTimer = setTimeout(() => {
        const ext = document.getElementById(`ext-app-${id}`);
        ext?.classList.add('is-ingested');
      }, index * intervalMs);
      activeTimers.push(launchTimer);

      // Step B: Hits the center Zenith core, activates slot, pulses Zenith
      const dockTimer = setTimeout(() => {
        const slot = document.getElementById(`slot-${id}`);
        slot?.classList.add('is-active');

        // Zenith core pulse
        if (coreIcon) {
          coreIcon.style.transform = 'scale(1.1)';
          setTimeout(() => {
            coreIcon.style.transform = 'scale(1)';
          }, 180);
        }

        if (ingestPulse) {
          ingestPulse.style.opacity = '1';
          setTimeout(() => {
            ingestPulse.style.opacity = '0';
          }, 240);
        }

        // Update counter & progress badge
        const count = index + 1;
        if (progressBadge) {
          progressBadge.textContent = `${count}/8 packed`;
          progressBadge.className = 'text-emerald-400 font-medium';
        }
        if (counterText) {
          counterText.textContent = `Packing apps into Zenith… (${count}/8)`;
        }

        // If this is the final 8th app: sequence complete celebration!
        if (count === 8) {
          isAnimating = false;
          if (pillText) pillText.textContent = '8 in 1 Unified';
          if (statusPill) {
            statusPill.className = 'flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-0.5 font-mono text-[10px] text-emerald-300';
          }
          if (counterText) {
            counterText.textContent = '8 utilities packed into 1 native binary';
          }
          if (progressBadge) {
            progressBadge.textContent = '8/8 active';
          }

          // Gentle card celebration pulse
          if (masterCard) {
            masterCard.style.transform = 'scale(1.02)';
            setTimeout(() => {
              masterCard.style.transform = 'scale(1)';
            }, 300);
          }

          // Confetti celebration
          const rect = masterCard?.getBoundingClientRect();
          if (rect) {
            const x = (rect.left + rect.width / 2) / window.innerWidth;
            const y = (rect.top + rect.height / 2) / window.innerHeight;
            confetti({
              particleCount: 30,
              spread: 60,
              origin: { x, y },
              colors: ['#34d399', '#ffffff', '#6ee7b7'],
              ticks: 80,
              gravity: 0.8,
              scalar: 0.6,
              disableForReducedMotion: true
            });
          }
        }
      }, index * intervalMs + 320); // 320ms flight time to reach center
      activeTimers.push(dockTimer);
    });
  }

  // Initialize: unified state by default
  setUnifiedImmediate();

  btnSeparated?.addEventListener('click', () => {
    setSeparatedImmediate();
  });

  btnUnified?.addEventListener('click', () => {
    playOneByOneAbsorption();
  });

  replayBtn?.addEventListener('click', () => {
    setSeparatedImmediate();
    setTimeout(() => {
      playOneByOneAbsorption();
    }, 450);
  });

  // When scrolled into view for the first time:
  // Show them separated briefly (0.5s) so user sees the 8 apps, then play random one-by-one absorption!
  if (container) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && !autoPlayed) {
            autoPlayed = true;
            setSeparatedImmediate();
            setTimeout(() => {
              playOneByOneAbsorption();
            }, 550);
            io.disconnect();
          }
        });
      },
      { threshold: 0.25 }
    );
    io.observe(container);
  }
</script>
