---
import { Zap, Feather, ShieldCheck } from 'lucide-astro';

const metrics = [
  {
    icon: Zap,
    label: "Fast",
    value: "<0.08s",
    note: "Native Rust binary. No runtime to warm up.",
    bar: "w-[6%] bg-white",
    sub: "vs ~4s for Electron cleaners",
  },
  {
    icon: Feather,
    label: "Light",
    value: "~80 MB",
    note: "Closed panel polls nothing. No battery drain.",
    bar: "w-[16%] bg-white",
    sub: "vs ~500 MB for Electron apps",
  },
  {
    icon: ShieldCheck,
    label: "Safe",
    value: "100% local",
    note: "Only verified caches are deletable. Source code is never touched.",
    bar: "w-full bg-emerald-400",
    sub: "0 bytes leave your machine",
  },
];
---

<section id="performance" class="relative py-24 sm:py-32">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="eyebrow flex items-center gap-2">
        <span class="eyebrow-dot"></span> Fast, light, safe
      </p>
      <h2 class="mt-4 text-balance text-3xl font-semibold tracking-tight text-white sm:text-5xl font-display">
        A cleaner that doesn't slow you down.
      </h2>
    </div>

    <div id="metrics" class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
      {metrics.map((m) => {
        const Icon = m.icon;
        return (
          <div class="card card-hover p-7">
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase tracking-widest text-zinc-500 font-mono">{m.label}</span>
              <Icon class="h-4 w-4 text-zinc-400" />
            </div>
            <div class="mt-3 font-mono text-4xl font-semibold tracking-tight text-white sm:text-5xl">{m.value}</div>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">{m.note}</p>
            <div class="mt-5 h-1 overflow-hidden rounded-full bg-zinc-800">
              <div class={`metric-bar h-full rounded-full ${m.bar}`}></div>
            </div>
            <p class="mt-2 font-mono text-[11px] text-zinc-500">{m.sub}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  const metrics = document.getElementById('metrics');
  if (metrics) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            metrics.classList.add('in-view');
            io.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    io.observe(metrics);
  }
</script>
