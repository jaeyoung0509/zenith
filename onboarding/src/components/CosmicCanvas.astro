---
// CosmicCanvas.astro: Clean, realistic deep-space starfield with gentle parallax & subtle twinkling
---

<canvas id="cosmic-canvas" class="fixed inset-0 pointer-events-none z-0 h-full w-full opacity-80 transition-opacity duration-1000"></canvas>

<script>
  interface Star {
    x: number;
    y: number;
    baseX: number;
    baseY: number;
    size: number;
    baseAlpha: number;
    alpha: number;
    twinkleSpeed: number;
    twinkleOffset: number;
    layer: number; // 1: far (tiny, slow parallax), 2: mid, 3: near
    color: string;
  }

  interface Meteor {
    x: number;
    y: number;
    length: number;
    speed: number;
    angle: number;
    alpha: number;
    active: boolean;
  }

  const canvas = document.getElementById('cosmic-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (ctx) {
      let width = (canvas.width = window.innerWidth);
      let height = (canvas.height = window.innerHeight);

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Elegant star density
      const starCount = Math.floor(Math.min(width, 1920) * 0.1);
      const stars: Star[] = [];

      function initStars() {
        stars.length = 0;
        for (let i = 0; i < starCount; i++) {
          const layer = Math.random() < 0.7 ? 1 : Math.random() < 0.9 ? 2 : 3;
          const size = layer === 1 ? Math.random() * 0.7 + 0.4 : layer === 2 ? Math.random() * 1.0 + 0.6 : Math.random() * 1.4 + 0.9;
          
          // Realistic starlight palette (pure white, slight ice blue, slight warm white)
          const colors = ['255, 255, 255', '220, 235, 255', '240, 245, 255', '210, 230, 255'];
          const color = colors[Math.floor(Math.random() * colors.length)];

          const x = Math.random() * width;
          const y = Math.random() * height;

          stars.push({
            x,
            y,
            baseX: x,
            baseY: y,
            size,
            baseAlpha: layer === 1 ? Math.random() * 0.35 + 0.15 : layer === 2 ? Math.random() * 0.5 + 0.25 : Math.random() * 0.6 + 0.35,
            alpha: 0,
            twinkleSpeed: Math.random() * 0.02 + 0.005,
            twinkleOffset: Math.random() * Math.PI * 2,
            layer,
            color
          });
        }
      }

      // Occasional faint shooting star
      let activeMeteor: Meteor | null = null;
      let nextMeteorTime = Date.now() + 4000 + Math.random() * 5000;

      function spawnMeteor() {
        const startX = Math.random() * (width * 0.6) + width * 0.2;
        const startY = Math.random() * (height * 0.3);
        activeMeteor = {
          x: startX,
          y: startY,
          length: Math.random() * 70 + 50,
          speed: Math.random() * 8 + 10,
          angle: (Math.PI / 4) + (Math.random() - 0.5) * 0.2,
          alpha: 0.8,
          active: true
        };
      }

      // Smooth subtle mouse parallax
      let mouseX = 0;
      let mouseY = 0;
      let targetMouseX = 0;
      let targetMouseY = 0;

      window.addEventListener('mousemove', (e) => {
        targetMouseX = (e.clientX / width - 0.5) * 20;
        targetMouseY = (e.clientY / height - 0.5) * 20;
      }, { passive: true });

      function resize() {
        if (!canvas) return;
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
        initStars();
      }

      window.addEventListener('resize', resize);
      resize();

      let isVisible = true;
      document.addEventListener('visibilitychange', () => {
        isVisible = !document.hidden;
        if (isVisible) requestAnimationFrame(loop);
      });

      let time = 0;

      function loop() {
        if (!isVisible || !ctx || !canvas) return;

        mouseX += (targetMouseX - mouseX) * 0.05;
        mouseY += (targetMouseY - mouseY) * 0.05;

        ctx.clearRect(0, 0, width, height);
        time += 0.016;

        // Draw pin-point realistic stars (no artificial spiderweb lines!)
        for (let i = 0; i < stars.length; i++) {
          const s = stars[i];

          // Gentle parallax shift based on depth layer
          const px = s.baseX + mouseX * (s.layer * 0.4);
          const py = s.baseY + mouseY * (s.layer * 0.4);

          const twinkle = Math.sin(time * s.twinkleSpeed * 60 + s.twinkleOffset);
          s.alpha = Math.max(0.1, Math.min(0.9, s.baseAlpha + twinkle * 0.25));

          ctx.beginPath();
          ctx.arc(px, py, s.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${s.color}, ${s.alpha})`;
          ctx.fill();
        }

        // Faint graceful shooting star
        const now = Date.now();
        if (!activeMeteor && now > nextMeteorTime && !prefersReducedMotion) {
          spawnMeteor();
          nextMeteorTime = now + 6000 + Math.random() * 8000;
        }

        if (activeMeteor && activeMeteor.active) {
          const m = activeMeteor;
          const endX = m.x - Math.cos(m.angle) * m.length;
          const endY = m.y - Math.sin(m.angle) * m.length;

          const grad = ctx.createLinearGradient(m.x, m.y, endX, endY);
          grad.addColorStop(0, `rgba(255, 255, 255, ${m.alpha * 0.8})`);
          grad.addColorStop(0.25, `rgba(200, 230, 255, ${m.alpha * 0.4})`);
          grad.addColorStop(1, 'rgba(200, 230, 255, 0)');

          ctx.beginPath();
          ctx.moveTo(m.x, m.y);
          ctx.lineTo(endX, endY);
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.0;
          ctx.stroke();

          m.x += Math.cos(m.angle) * m.speed;
          m.y += Math.sin(m.angle) * m.speed;
          m.alpha -= 0.02;

          if (m.alpha <= 0 || m.x > width + 100 || m.y > height + 100) {
            m.active = false;
            activeMeteor = null;
          }
        }

        if (!prefersReducedMotion) {
          requestAnimationFrame(loop);
        }
      }

      requestAnimationFrame(loop);
    }
  }
</script>
